# Dependencies
node_modules/
.pnp/
.pnp.js

# npm-only project (ADR-09). pnpm artifacts must never be committed —
# their presence makes Next's auto-installer shell out to pnpm, absent on Hostinger.
pnpm-lock.yaml
pnpm-workspace.yaml

# Build output
.next/
out/
build/
dist/

# Env — catch every variant including Finder duplicates
# ('.env copy', '.env.local copy 2', etc.), backups, and OS-named clones.
.env
.env.*
.env*
*.env
*.env.*
# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

